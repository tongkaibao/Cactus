---
import PageLayout from "@/layouts/Base";
// 如果你不需要博文，就不用导入 getAllPosts 等函数了
---

<PageLayout meta={{ title: "首页" }}>
  <section>
    <h1 class="title mb-6">你好，这是我的自定义主页</h1>
    <p class="mb-4">
      在这里你可以写任何你想要展示的内容，比如自我介绍、项目链接或者一段骚话。
    </p>
    
    <div class="space-y-4">
      <h2 class="title text-xl">我的项目</h2>
      <ul class="list-inside list-disc">
        <li>项目 A - 描述</li>
        <li>项目 B - 描述</li>
      </ul>
    </div>
  </section>
</PageLayout>
